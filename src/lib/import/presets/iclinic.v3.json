{
  "source": "iclinic",
  "version": 3,
  "label": "iClinic",
  "spec": "integrations/iclinic.md (the official import model at docs.iclinic.com.br); to confirm with a real export",
  "requires": [
    "import-address"
  ],
  "fingerprint": {
    "zip_files": [
      "patient.csv"
    ],
    "headers_all": [
      "name",
      "birth_date"
    ],
    "headers_any": [
      "civil_name",
      "social_gender"
    ]
  },
  "unlisted": "generic_suggest",
  "read": {
    "encodings": [
      "utf-8",
      "windows-1252"
    ],
    "delimiters": [
      ",",
      ";"
    ]
  },
  "columns": {
    "civil_name": {
      "field": "full_name",
      "priority": 1
    },
    "name": {
      "field": "full_name",
      "priority": 2,
      "else_extra": "Nome social"
    },
    "birth_date": {
      "field": "birth_date"
    },
    "gender": {
      "field": "sex",
      "values": {
        "f": "female",
        "m": "male"
      }
    },
    "social_gender": {
      "extra": "Gênero",
      "values": {
        "ag": "Agênero",
        "ci": "Cisgênero",
        "nb": "Não binário",
        "ts": "Transgênero"
      }
    },
    "cpf": {
      "field": "cpf"
    },
    "rg": {
      "field": "rg"
    },
    "rg_issuer": {
      "extra": "Órgão emissor do RG"
    },
    "mobile_phone": {
      "field": "phone",
      "priority": 1,
      "else_extra": "Celular"
    },
    "home_phone": {
      "field": "phone",
      "priority": 2,
      "else_extra": "Telefone residencial"
    },
    "office_phone": {
      "field": "phone",
      "priority": 3,
      "else_extra": "Telefone comercial"
    },
    "email": {
      "field": "email"
    },
    "email_secondary": {
      "extra": "E-mail secundário"
    },
    "occupation": {
      "field": "profession"
    },
    "tag_names": {
      "field": "tags",
      "split": "~"
    },
    "zip_code": {
      "field": "address_postal_code"
    },
    "address": {
      "field": "address_street"
    },
    "number": {
      "field": "address_number"
    },
    "complement": {
      "field": "address_complement"
    },
    "neighborhood": {
      "field": "address_neighborhood"
    },
    "city": {
      "field": "address_city"
    },
    "state": {
      "field": "address_state"
    },
    "country": {
      "extra": "País"
    },
    "cns": {
      "field": "cns"
    },
    "observation": {
      "extra": "Observações"
    },
    "patient_code": {
      "extra": "Código no iClinic"
    },
    "died": {
      "field": "archived",
      "values": {
        "0": null,
        "1": "deceased"
      }
    },
    "death_info": {
      "extra": "Óbito"
    },
    "active": {
      "field": "archived",
      "values": {
        "0": "inactive",
        "1": null
      }
    },
    "birth_place": {
      "extra": "Naturalidade"
    },
    "birth_state": {
      "extra": "UF de nascimento"
    },
    "nationality": {
      "extra": "Nacionalidade"
    },
    "ethnicity": {
      "extra": "Raça/cor",
      "sensitive": true,
      "values": {
        "ye": "Amarela",
        "wh": "Branca",
        "bl": "Preta",
        "br": "Parda",
        "in": "Indígena"
      }
    },
    "marital_status": {
      "extra": "Estado civil",
      "values": {
        "si": "Solteiro(a)",
        "ma": "Casado(a)",
        "se": "Separado(a)",
        "di": "Divorciado(a)",
        "wi": "Viúvo(a)",
        "st": "União estável"
      }
    },
    "religion": {
      "extra": "Religião",
      "sensitive": true
    },
    "education": {
      "extra": "Escolaridade"
    },
    "responsible": {
      "extra": "Responsável"
    },
    "indication": {
      "extra": "Indicação"
    },
    "indication_observation": {
      "extra": "Observação da indicação"
    },
    "receive_email": {
      "extra": "Aceita e-mails",
      "values": {
        "0": "Não",
        "1": "Sim"
      }
    },
    "patientrelatedness_mother_names": {
      "extra": "Nome da mãe",
      "split": "~",
      "join": ", "
    },
    "patientrelatedness_father_names": {
      "extra": "Nome do pai",
      "sensitive": true,
      "split": "~",
      "join": ", "
    },
    "healthinsurance_pack": {
      "extra": "Convênios (sistema anterior)"
    },
    "tag_physician_id": {
      "ignore": true
    },
    "picture_filename": {
      "ignore": true
    }
  }
}
